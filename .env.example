# Copy to .env on the server (next to docker-compose.yml) and fill real values.
# Used by docker-compose for the production stack. DO NOT commit the real .env.

# PostgreSQL (container)
DB_USER=ucb
DB_PASSWORD=change-me-strong-db-password
DB_NAME=coursebuilder

# App
AUTH_SECRET=change-me-32+-random-bytes
APP_PORT=3000

# First admin account (created by `prisma db seed` on startup; idempotent)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=change-me-admin-password
SEED_ADMIN_NAME=ผู้ดูแลระบบ

# Local development (NOT used by docker-compose) — Prisma CLI reads this:
# DATABASE_URL="postgresql://user@localhost:5432/coursebuilder_dev?schema=public"
